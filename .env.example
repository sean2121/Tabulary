# Copy to .env and fill in what you use. Only one LLM provider is needed.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Local LLM through Ollama on the host machine
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=mistral:latest
# Password of the bundled demo Postgres (used by both containers and by the "demo" connections)
DEMO_DB_PASSWORD=tabulary
# Passwords of your own databases: a saved connection names the variable, this file holds the value.
# TABULARY_PW_CRM=secret
# Ontop CLI directory when running outside Docker (the image sets it to /opt/ontop)
# ONTOP_HOME=/path/to/ontop-cli-5.5.0
# Host port of the web UI
APP_PORT=8000
# Set to 0 to skip downloading the university demo database
LOAD_DEMO=1
